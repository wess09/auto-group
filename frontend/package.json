    "@types/sortablejs": "^1.15.9",
    "axios": "^1.7.7",
    "echarts": "^6.1.0",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vuetify": "4.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vite-plugin-vuetify": "2.1.3",
