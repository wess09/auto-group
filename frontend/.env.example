# 前端部署到 CDN 时填写后端 API 地址，必须包含 /api
VITE_API_BASE_URL=https://bot.example.com/api

# 网站名称，用于标签页、登录页和后台品牌名；留空默认 Auto Group
VITE_APP_NAME=Auto Group

# 可选：网站图标的 HTTP/HTTPS 直链，构建时下载到 dist；留空不设置自定义 favicon
VITE_APP_ICON_URL=

# 可选：完整管理 WS 地址；留空时由 API 地址自动推导为 ws/wss
VITE_WS_BASE_URL=

# 自定义后台入口；要和后端 ADMIN_ROUTE_PREFIX 保持一致
VITE_ADMIN_ROUTE_PREFIX=/manage-a8f3c2

# 阿里云 ESA 验证码；留空时登录页不启用验证码
VITE_ALIYUN_CAPTCHA_REGION=cn
VITE_ALIYUN_CAPTCHA_PREFIX=
VITE_ALIYUN_CAPTCHA_SCENE_ID=
